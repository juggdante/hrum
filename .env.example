# --- Warehouse (local DuckDB) ---
HRUM_DB_PATH=data/hrum.duckdb
SF_COMP_CSV=                      # optional: local path to an already-downloaded SF Comp CSV (skips download)

# --- LLM (agent/llm) ---
LLM_PROVIDER=qwen_local           # qwen_local | qwen_candidate | anthropic | openai
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=change-me            # must match --api-key passed to vLLM
QWEN_MODEL=qwen                   # --served-model-name in vLLM
HF_TOKEN=                         # optional, speeds up model download
VLLM_BIN=                         # optional; default ~/.venvs/vllm/bin/vllm, then `vllm` on PATH
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Observability (Langfuse, self-hosted: infra/langfuse/README.md). Empty keys = tracing off ---
LANGFUSE_HOST=http://127.0.0.1:3000   # or LANGFUSE_BASE_URL; use 127.0.0.1, not localhost (ports bind IPv4 only)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MCP gateway ---
HRUM_JWT_SECRET=                  # >= 32 chars, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
HRUM_MCP_ROLE=chro                # role for the stdio transport (local trusted client)
